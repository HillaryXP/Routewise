# Routewise config. Copy to .env locally; set these as env vars on your host.
# Public addresses only. Never put a seed phrase or private key anywhere in this project.

PORT=3000

# Receiving wallet (public Solana address that gets the USDC payments)
PAY_TO_SOL=Gko1oPNaFLPQZhhFLjmkWLfoPnNR139T2XQq7R9Cd9xZ

# Solana MAINNET (PayBox pays real USDC). Devnet id for testing: solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_SOL_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

# Facilitator must support Solana mainnet. Try Dexter first, PayAI as backup:
#   https://dexter.cash/facilitator
#   https://facilitator.payai.network
FACILITATOR_URL=https://dexter.cash/facilitator

# Price per call (USD, paid in USDC)
PRICE_RATES=$0.005
PRICE_ROUTE=$0.01
PRICE_TIMING=$0.01
